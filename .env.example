# Optional local overrides for YOUR machine. Copy to .env if you need them.
# .env is gitignored. Do not commit it, and do not put another computer's
# address in it. Leave a variable unset to keep the built-in default.
#
# Worker and sidecar always bind to loopback. These files do not change that.
# Defaults the Blender addon expects: http://127.0.0.1:8765 and http://127.0.0.1:8766

# Generated GLBs. Default: %LOCALAPPDATA%\localtext3d\outputs (Windows)
# or ~/.cache/localtext3d/outputs (Linux).
# LOCALTEXT3D_OUTPUT_DIR=/path/to/localtext3d-outputs

# GUI Agent recordings and learned videos. Default: ~/LocalText3D/agent_dataset
# Learn-from-video only reads files inside this folder.
# LOCALTEXT3D_AGENT_DATASET=/path/to/agent_dataset

# Clone used when Blender starts the sidecar. Example: /path/to/LocalText3D
# LOCALTEXT3D_ROOT=/path/to/LocalText3D

# After model weights are cached, set to 1 so the worker stays offline.
# HF_HUB_OFFLINE=1
